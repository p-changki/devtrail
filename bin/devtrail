#!/usr/bin/env bash
# DevTrail — 개발 기록 자동화 환경 부트스트래퍼
# https://github.com/p-changki/devtrail
#
# 사용법: devtrail <command> [options]

set -uo pipefail

_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do _self="$(readlink "$_self")"; done
DEVTRAIL_ROOT="$(cd "$(dirname "$_self")/.." && pwd)"
export DEVTRAIL_ROOT

# shellcheck source=lib/common.sh
. "$DEVTRAIL_ROOT/lib/common.sh"

# 버전의 단일 출처는 VERSION 파일이다.
# 두 곳에 박아두면 릴리스할 때 한쪽을 빠뜨린다 — 실제로 그랬다.
VERSION=$(cat "$DEVTRAIL_ROOT/VERSION" 2>/dev/null || echo "0.0.0-dev")

usage() {
  cat <<EOF
${C_BOLD}DevTrail${C_RESET} v$VERSION — 개발 기록 자동화 환경 부트스트래퍼

${C_BOLD}설치${C_RESET}
  devtrail init              대화형 셋업 (저장소·볼트·GitHub·AI 선택)
  devtrail doctor            진단 — 의존성·인증·권한·자동화 상태
  devtrail scan [VAULT]      볼트 진단 — 구조·메타·충돌 (쓰기 없음)
  devtrail augment [모듈]    없는 폴더·허브만 생성 (기본 dry-run)
  devtrail skills <sub>      AI 스킬 설치 (install|sync|list|remove)
  devtrail obsidian          Obsidian 설정 적용 (병합 — 덮어쓰지 않음)
  devtrail app <sub>         메뉴바 앱 (install|start|stop|status)
  devtrail dashboard         웹 대시보드 (상태·실행·설정)
  devtrail install-schedule  launchd 자동 실행 등록
  devtrail uninstall         자동화 제거 (볼트 데이터는 건드리지 않음)

${C_BOLD}실행${C_RESET}
  devtrail activity [DATE]   GitHub 이슈/PR을 개발일지에 삽입
  devtrail summary  [DATE]   머지된 PR을 AI로 쉬운말 요약해 삽입
  devtrail weekly            이번 주 주간리뷰 초안 생성
  devtrail backfill [DATE]   지난 날짜의 활동·요약을 채워 넣기
  devtrail sync              프로젝트 docs → 볼트 동기화

${C_BOLD}기타${C_RESET}
  devtrail config [get|set]  설정 조회/변경 (UI도 이 명령을 씁니다)
  devtrail path [KEY]        볼트 경로 조회 (--rel: Dataview용 상대경로)
  devtrail version

${C_DIM}설정 파일: $CONFIG_FILE${C_RESET}
EOF
}

cmd="${1:-}"
[ $# -gt 0 ] && shift

case "$cmd" in
  init)
    . "$DEVTRAIL_ROOT/lib/init.sh"; init_run "$@" ;;
  doctor)
    . "$DEVTRAIL_ROOT/lib/doctor.sh"; doctor_run "$@" ;;
  obsidian)
    . "$DEVTRAIL_ROOT/lib/obsidian.sh"; obsidian_apply "$@" ;;
  app)
    . "$DEVTRAIL_ROOT/lib/appcmd.sh"; app_cmd "$@" ;;
  dashboard)
    . "$DEVTRAIL_ROOT/lib/dashboard.sh"; dashboard_run "$@" ;;
  install-schedule)
    . "$DEVTRAIL_ROOT/lib/schedule.sh"; schedule_install "$@" ;;
  uninstall)
    . "$DEVTRAIL_ROOT/lib/schedule.sh"; schedule_uninstall "$@" ;;
  activity|summary|weekly|daily|backfill)
    require_config
    script="$DEVTRAIL_HOME/scripts/$cmd.sh"
    [ -x "$script" ] || die "스크립트 없음: $script  ('devtrail init' 실행 필요)"
    exec "$script" "$@" ;;
  sync)
    require_config
    script="$DEVTRAIL_HOME/scripts/repodocs.sh"
    [ -x "$script" ] || die "스크립트 없음: $script  ('devtrail init' 실행 필요)"
    exec "$script" "$@" ;;
  config)
    . "$DEVTRAIL_ROOT/lib/configcmd.sh"; config_cmd "$@" ;;
  path)
    . "$DEVTRAIL_ROOT/lib/pathcmd.sh"; path_cmd "$@" ;;
  scan)
    . "$DEVTRAIL_ROOT/lib/doctor.sh"   # _d_section 재사용
    . "$DEVTRAIL_ROOT/lib/scancmd.sh"; scan_cmd "$@" ;;
  augment)
    . "$DEVTRAIL_ROOT/lib/augmentcmd.sh"; augment_cmd "$@" ;;
  skills)
    . "$DEVTRAIL_ROOT/lib/doctor.sh"   # _d_section 재사용
    . "$DEVTRAIL_ROOT/lib/skillcmd.sh"; skills_cmd "$@" ;;
  version|--version|-v)
    printf 'devtrail %s\n' "$VERSION" ;;
  help|--help|-h|"")
    usage ;;
  *)
    fail "알 수 없는 명령: $cmd"; echo; usage; exit 1 ;;
esac
