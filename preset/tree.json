{
  "_comment": [
    "볼트 폴더 트리 정의. devtrail scaffold/augment 가 이걸 읽어 폴더를 만든다.",
    "",
    "key       : devtrail path <key> 로 조회하는 이름. 스킬·템플릿·쿼리가 이걸 쓴다.",
    "path      : 루트 아래 상대 경로. config.dirs 로 덮어쓸 수 있다.",
    "module    : 이 폴더가 속한 모듈. augment <module> 로 부분 설치한다.",
    "tag       : 이 폴더로 라우팅되는 태그. 없으면 라우팅 대상이 아니다.",
    "hub       : L3 폴더 허브를 만들지 여부.",
    "",
    "⚠️ 경로를 코드에 박지 말 것. 항상 devtrail path 로 조회한다."
  ],
  "version": 1,
  "modules": {
    "devlog": {
      "label": "개발일지 + GitHub 활동",
      "label_en": "Devlog + GitHub activity",
      "required": true
    },
    "review": {
      "label": "주간 · 월간 리뷰",
      "label_en": "Weekly · monthly reviews"
    },
    "project": {
      "label": "프로젝트 구조 + docs 골격",
      "label_en": "Project structure + docs skeleton"
    },
    "pkm": {
      "label": "자료실 · 카드노트 · MOC",
      "label_en": "Library · zettel · MOC"
    },
    "learn": {
      "label": "학습 시스템",
      "label_en": "Learning system"
    },
    "personal": {
      "label": "개인 (일기 · 책 · 스크랩)",
      "label_en": "Personal (journal · books · scraps)",
      "default": false
    }
  },
