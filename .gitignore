# DevTrail — 공개 저장소이므로 개인 데이터가 절대 들어가면 안 된다.

# 사용자 설정(볼트 경로·GitHub 계정 등 개인정보 포함)
devtrail.config.json
!templates/devtrail.config.json
*.config.local.json

# 시크릿
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# 렌더링 결과물(치환된 개인 경로 포함)
/rendered/
*.plist
!templates/launchd/*.plist.tmpl

# 로컬 문서 — 구현계획·리서치는 추적하지 않는다
# (장기 확정 결정만 docs/decisions/ 에 두고 예외 처리)
# ⚠️ docs/ 로 쓰면 git이 하위로 내려가지 않아 아래 예외가 무효가 된다.
#    디렉터리째 제외하면 재포함이 불가능하므로 docs/* 로 쓴다.
docs/*
!docs/decisions/
!docs/design-tokens.md
!docs/ARCHITECTURE.md
# 사용 가이드는 제품과 함께 나간다 — 구현계획이 아니다.
!docs/command-center-usage.md

# 저장소 루트의 로컬 학습·메모 — 결정 기록이 아니므로 추적하지 않는다.
# 오래 갈 결정은 docs/decisions/ 에 ADR 로 쓴다.
/programming-principles-study.md

# 로그·백업
logs/
*.log
*.bak
*.bak.*

# 빌드 산출물
__pycache__/
*.pyc
app/.build/
app/build/

# ⚠️ 개인 Claude Code 설정 — 절대 다시 들어가면 안 된다
#    한 번 커밋했다가 히스토리째 새로 시작해야 했다(2026-08-20).
#    개인 세션 실측치·장애 기록·구독 전제 규칙이 들어 있었다.
#    DevTrail 소유 스킬은 skills/ 에 있고 그것만 배포한다.
.claude/
claude/

# 볼트 · 테스트 산출물
#   레포 안에서 devtrail init 을 돌리면 이것들이 생긴다.
.devtrail/
.devtrail-home/
.obsidian/
.smart-env/
.trash/
devtrail-qa/
*-qa/

# 임시 파일
#   configcmd 가 설정을 원자적으로 교체할 때 만든다.
.devtrail-cfg.*
*.tmp
*.orig
*.rej
*.swp
*~

# 개발 환경
.venv/
venv/
node_modules/
.vscode/
.idea/

# OS
.DS_Store
._*
Thumbs.db
